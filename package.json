{
  "name": "zapis-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/tenant-static.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "tenant:new": "tsx scripts/tenant-new.ts",
    "tenant:validate": "tsx scripts/tenant-validate.ts",
    "tenant:publish": "tsx --env-file-if-exists=.env scripts/tenant-publish.ts",
    "tenant:verify": "tsx --env-file-if-exists=.env scripts/tenant-verify.ts",
    "tenant:owner": "tsx --env-file-if-exists=.env scripts/tenant-owner.ts",
    "tenant:static": "tsx scripts/tenant-static.ts",
    "setup:sql": "tsx scripts/build-setup-sql.ts",
    "test:db": "tsx --env-file-if-exists=.env.test tests/db/run.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.6.7",
    "@astryxdesign/core": "^0.6.7",
    "@astryxdesign/theme-neutral": "^0.6.7",
    "@radix-ui/react-slot": "^1.4.0",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}