{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/s/:slug/owner", "destination": "/s/:slug/owner/index.html" },
    { "source": "/s/:slug/owner/:path*", "destination": "/s/:slug/owner/index.html" },
    { "source": "/s/:slug", "destination": "/s/:slug/index.html" },
    { "source": "/s/:slug/:path*", "destination": "/s/:slug/index.html" }
  ],
  "headers": [
    { "source": "/s/:slug/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/s/:slug/(.*).webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
